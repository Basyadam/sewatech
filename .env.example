# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# KONFIGURASI DATABASE MYSQL
# ==========================================
# Host server database MySQL (contoh: localhost untuk XAMPP/Laragon, atau IP VPS/Cloud)
DB_HOST="localhost"

# Port MySQL standar (default: 3306)
DB_PORT="3306"

# Nama database yang dibuat di phpMyAdmin / MySQL
DB_NAME="sewatechgit"

# Username database (default XAMPP: root)
DB_USER="root"

# Password database (default XAMPP: kosong "")
DB_PASSWORD=""

# Aktifkan SSL jika menggunakan cloud database seperti PlanetScale / TiDB / Aiven (true/false)
DB_SSL="false"
